# Copy this file to `.env` and fill in your values.  `.env` is git-ignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   then edit .env
#
# Nothing here is required for Phase 0. It becomes relevant in Phase 1, when the
# Feature Induction Agent needs an endpoint. Any OpenAI-compatible server works.
#
# Precedence (highest first):  process environment  >  .env  >  config/settings.yaml
# The API key is never logged and never written into artifacts/.

# Turn the LLM layers on/off. Leave false to run the whole pipeline with no key.
EDA_LLM_ENABLED=false

# Base URL of an OpenAI-compatible endpoint. The client appends /chat/completions.
#   Ollama        http://localhost:11434/v1
#   vLLM / LM Studio / llama.cpp   http://localhost:8000/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   OpenAI        https://api.openai.com/v1
EDA_LLM_BASE_URL=http://localhost:11434/v1

# Only needed for a remote/paid endpoint. Leave empty for a local server.
EDA_LLM_API_KEY=

# Exact model id the endpoint expects, e.g. qwen2.5:7b-instruct or gpt-4o-mini.
EDA_LLM_MODEL=qwen2.5:7b-instruct

# Seconds before a single LLM call is abandoned.
EDA_LLM_TIMEOUT_S=120
